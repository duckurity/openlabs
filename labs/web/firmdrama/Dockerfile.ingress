FROM python:3.12.15-alpine3.24@sha256:8a001d79e5a57ae4de7faa57af12f3d589058ea06ac42ec850c1cb0ac325bd21

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN addgroup -S ingress && adduser -S -G ingress ingress

# The proxy uses only the Python standard library. Remove the package installer
# and bootstrap module so the final runtime carries no pip CVEs.
RUN rm -rf /usr/local/bin/pip /usr/local/bin/pip3 \
    /usr/local/lib/python3.12/ensurepip \
    /usr/local/lib/python3.12/site-packages/pip \
    /usr/local/lib/python3.12/site-packages/pip-*.dist-info

WORKDIR /app
COPY ingress_proxy.py ./ingress_proxy.py

USER ingress
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=6 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"

CMD ["python3", "/app/ingress_proxy.py"]
