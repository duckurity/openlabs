@page
@model VaultCorp.Pages.IndexModel
@{
    ViewData["Title"] = "Secure Cloud Backup";
}

<section class="hero">
    <h1>Enterprise Backup,<br/>Zero Compromise.</h1>
    <p>VaultCorp gives your team a private, encrypted backup workspace — ready in seconds.</p>
    <div class="hero-actions">
        <a href="/register" class="btn-primary">Start Free Trial</a>
        <a href="/login"    class="btn-outline">Sign In</a>
    </div>
</section>

<section class="features">
    <div class="feature-card">
        <span class="icon">🔒</span>
        <h3>End-to-End Encryption</h3>
        <p>Your data is encrypted before it ever leaves your device.</p>
    </div>
    <div class="feature-card">
        <span class="icon">⚡</span>
        <h3>Instant Restore</h3>
        <p>Recover files and databases in under 60 seconds.</p>
    </div>
    <div class="feature-card">
        <span class="icon">🌐</span>
        <h3>Import from URL</h3>
        <p>Pull backups directly from external storage endpoints.</p>
    </div>
</section>
