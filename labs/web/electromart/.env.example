# ---------- ElectroMart local environment ----------
# Copy this file to `.env` and change the values before starting.

# Port the app is published on the host (container port stays 3000).
APP_PORT=3000

# MongoDB superuser (created by the mongo:7 image on first start).
MONGO_INITDB_ROOT_USERNAME=electromart
MONGO_INITDB_ROOT_PASSWORD=change-me-to-a-strong-local-password

# Secret used to sign the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-random-64-char-hex-secret

# Session lifetime in milliseconds (default: 7 days = 604800000).
SESSION_MAX_AGE=604800000

# bcrypt work factor (10–15; 12 is a good default).
BCRYPT_ROUNDS=12

# Lab reset on boot (default: true). Keeps the lab pristine for this account-
# takeover exercise: every boot clears extra accounts, carts, user reviews and
# stale sessions (and any takeover of the victim), then re-seeds the 20
# products + the original victim. So "reset the Docker" = a fresh lab where a
# brand-new user can always register. Set to false to persist data across
# restarts (like a normal production app).
LAB_RESET_ON_BOOT=true

# The Compose lab is HTTP-only. Keep this false so the browser does not rewrite
# internal HTTP subresources/form posts to HTTPS. Set true behind a TLS proxy.
CSP_UPGRADE_INSECURE_REQUESTS=false

# ---------- Persistent Victim Bot (Phase 2) ----------
# Internal Compose URL. "app.test" is a Docker network alias for the app
# service: Chromium upgrades bare "app" to HTTPS because .app is an HSTS TLD.
ELECTROMART_BASE_URL=http://app.test:3000
BOT_READY_PATH=/api/health

# Victim account (the seeded lab victim logs in with its USERNAME, not email).
VICTIM_USERNAME=victim
VICTIM_EMAIL=victimEmail@gmail.com
# Leave VICTIM_PASSWORD unset/empty to use the documented lab seed password.
# To override it locally, uncomment and set the same value the app seeded:
# VICTIM_PASSWORD=your-local-lab-password

# Persistent-loop behaviour.
BOT_CYCLE_INTERVAL_MS=60000
BOT_TIMEOUT_MS=30000
BOT_MAX_RETRIES=3
BOT_RETRY_BASE_DELAY_MS=1000
BOT_HEADLESS=true
BOT_SCREENSHOTS_ON_FAILURE=false
# Empty = discover and visit every product card on /home (recommended).
# Set an explicit comma-separated list to restrict the cycle to a subset.
BOT_PRODUCT_PATHS=
BOT_READY_TIMEOUT_MS=120000
BOT_READY_POLL_MS=2000
BOT_SHUTDOWN_TIMEOUT_MS=15000
BOT_LOG_LEVEL=info

# Review-comment internal-link observation. The bot follows at most one
# lab-scoped link per cycle; external domains and unsupported schemes are
# rejected. The app origin is always allowed, so this can stay empty unless a
# second Docker lab origin is explicitly allowlisted.
BOT_COMMENT_LINKS_ENABLED=true
BOT_ALLOWED_LINK_ORIGINS=

# ---------- OAST callback service (Phase 3) ----------
# Internal callback origin used by the OAST service and the victim bot. The
# hostname is a Docker network alias; do not use localhost here.
OAST_PUBLIC_URL=http://attckerserver.local:4000
OAST_BASE_URL=http://attckerserver.local:4000
BOT_OAST_READY_PATH=/health
# Host loopback port for the dashboard/API. Bound to 127.0.0.1 by Compose.
# OAST interactions are in-memory: `docker compose down` or an image rebuild
# starts with an empty dashboard. The bot's startup check may add one entry.
OAST_HOST_PORT=4000
# Bounded in-memory interaction history. The dashboard shows request headers
# and raw bodies, so keep the OAST host binding local and use synthetic data.
OAST_MAX_INTERACTIONS=1000
OAST_DASHBOARD_LIMIT=100
OAST_MAX_BODY_BYTES=16384
OAST_REQUEST_TIMEOUT_MS=10000
OAST_LOG_LEVEL=info
# One isolated XSS/OAST proof-of-execution check per bot process.
BOT_XSS_CHECK_ENABLED=true
BOT_XSS_CHECK_TIMEOUT_MS=15000
BOT_XSS_CHECK_NEGATIVE_WAIT_MS=2000

# 0 = run forever. Set 2 only for a bounded two-cycle verification run.
BOT_MAX_CYCLES=0

