---
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/openlabs/#labs', label: 'Labs' },
  { href: '/openlabs/#tracks', label: 'Tracks' },
  { href: '/openlabs/#play', label: 'How to play' },
  { href: '/openlabs/#rules', label: 'Rules' },
];

---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="site-header__brand" href="/openlabs/" aria-label="Openlabs home">
      <span class="site-header__word">openlabs</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul role="list">
        {nav.map((item) => (
          <li>
            <a class="site-header__link" href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__cta" href="/openlabs/#play">
        1 lab live
        <span class="site-header__cta-pulse" aria-hidden="true"></span>
      </a>
      <ThemeToggle mode="system" />
    </div>
  </div>
  <nav class="site-header__mobile" aria-label="Primary">
    <ul role="list">
      {nav.map((item) => (
        <li>
          <a class="site-header__link" href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-overlay);
    -webkit-backdrop-filter: blur(var(--blur-overlay)) saturate(160%);
    backdrop-filter: blur(var(--blur-overlay)) saturate(160%);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    max-width: var(--layout-max);
    margin-inline: auto;
    padding: var(--space-3) var(--layout-gutter);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .site-header__brand:hover { opacity: 0.8; }

  .site-header__word {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }

  .site-header__nav ul {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
  }

  .site-header__link {
    position: relative;
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: var(--radius);
    transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }

  .site-header__link::after {
    content: '';
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: var(--space-1);
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-in-out);
  }
  .site-header__link:hover { color: var(--color-text); }
  .site-header__link[aria-current='page']::after { transform: scaleX(1); }
  @media (hover: hover) and (pointer: fine) {
    .site-header__link:hover::after { transform: scaleX(1); }
  }
  .site-header__link[aria-current='page'] { color: var(--color-text); }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .site-header__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--text-eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-accent-text);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-accent);
    transition: transform var(--dur-press) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .site-header__cta:hover {
    background: var(--color-text);
    color: var(--color-page);
    border-color: var(--color-text);
  }
  .site-header__cta:active { transform: scale(var(--motion-press-scale)); }

  .site-header__cta-pulse {
    width: 7px;
    height: 7px;
    background: currentColor;
  }

  @media (max-width: 720px) {
    .site-header__nav { display: none; }
    .site-header__mobile {
      display: block;
      border-top: 1px solid var(--color-border);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .site-header__mobile::-webkit-scrollbar { display: none; }
    .site-header__mobile ul {
      display: flex;
      gap: var(--space-1);
      list-style: none;
      padding: var(--space-1) var(--layout-gutter);
      margin: 0;
      min-width: max-content;
    }
  }
  @media (min-width: 721px) {
    .site-header__mobile { display: none; }
  }
</style>