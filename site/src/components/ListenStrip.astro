---
import { WELCOME_AUDIO_URL } from '../data/site';

// Compact custom welcome player. Native audio underneath, brand skin on top.
// Full keyboard support via the track slider and a real button.
const bars = [24, 38, 54, 62, 52, 40, 28, 44, 70, 58, 42, 32, 50, 62, 46, 36, 24, 36];
const hot = new Set([3, 8, 13]);
---

<div class="listen" data-listen data-reveal>
  <div class="listen__row">
    <button class="listen__play" type="button" data-listen-play aria-label="Play the welcome" aria-pressed="false">
      <span class="listen__glyph" aria-hidden="true"></span>
    </button>
    <div class="listen__wave" aria-hidden="true">
      {bars.map((h, i) => (
        <span class={hot.has(i) ? 'is-hot' : undefined} style={`height: ${h}%`}></span>
      ))}
    </div>
  </div>
  <div
    class="listen__track"
    data-listen-track
    role="slider"
    tabindex="0"
    aria-label="Seek in the welcome"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    <div class="listen__rail"></div>
    <div class="listen__fill" data-listen-fill></div>
  </div>
  <div class="listen__time">
    <span data-listen-cur>0:00</span>
    <span data-listen-dur>0:00</span>
  </div>
  <audio preload="metadata" src={WELCOME_AUDIO_URL}></audio>
</div>