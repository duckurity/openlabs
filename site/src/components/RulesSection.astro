---
import SectionHeading from './SectionHeading.astro';

const rules = [
  'Labs run offline once images are pulled. No runtime network calls.',
  'One documented host port per lab.',
  'Flags follow the duck{...} format. The hash ships. The plaintext stays inside lab internals.',
  'Written content follows one voice. Short declaratives. No hype.',
];
---

<section class="section wrap" id="rules" aria-labelledby="rules-title">
  <div id="rules-title"><SectionHeading eyebrow="Contract" title="Ground rules" lede="The rules are few. Each one protects the solve." /></div>
  <div class="rules" data-reveal>
    {rules.map((rule) => (
      <div class="rule">
        <span class="rule__mark" aria-hidden="true"></span>
        <p>{rule}</p>
      </div>
    ))}
  </div>
</section>