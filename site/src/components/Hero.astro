---
import ListenStrip from './ListenStrip.astro';

interface Props {
  labCount: number;
}
const { labCount } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero__grid">
    <div class="hero__copy">
      <p class="eyebrow" data-reveal>Open source security labs</p>
      <h1 class="display" id="hero-title" data-reveal style="--reveal-delay: 50ms">
        Break a real service. Find the flag.
      </h1>
      <p class="lede" data-reveal style="--reveal-delay: 100ms">
        Openlabs ships small labs that run in Docker. Pick a lab. Read the
        brief. Solve on your own machine.
      </p>
      <div class="hero__cta" data-reveal style="--reveal-delay: 150ms">
        <a class="btn btn--primary" href={`${base}/#labs`}>
          Browse labs <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href={`${base}/#play`}>Read the quick start</a>
      </div>
      <ul class="hero__meta" role="list" data-reveal style="--reveal-delay: 150ms">
        <li><span class="hero__live" aria-hidden="true"></span>{labCount} {labCount === 1 ? 'lab' : 'labs'} live</li>
        <li>Docker only</li>
        <li>No accounts</li>
      </ul>
    </div>
    <div class="hero__side">
      <p class="eyebrow" data-reveal style="--reveal-delay: 100ms">Listen</p>
      <ListenStrip />
      <p class="hero__hint" data-reveal style="--reveal-delay: 200ms">
        Press play to hear the welcome.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: var(--space-12);
  }
  /* Single sanctioned atmosphere: ember ground-tone rising from the base. */
  .hero::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 26%;
    background: var(--gradient-ember-soft);
    pointer-events: none;
  }
  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-10);
  }
  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--space-16);
      align-items: end;
    }
  }
  .hero__copy {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  .hero__copy .display {
    max-width: 14ch;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    list-style: none;
    padding: 0;
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    color: var(--color-text-tertiary);
  }
  .hero__meta li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .hero__live {
    width: 7px;
    height: 7px;
    background: var(--color-text-tertiary);
  }
  .hero__side {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .hero__hint {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
  }
</style>