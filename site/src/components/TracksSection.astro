---
import SectionHeading from './SectionHeading.astro';
import { TRACKS } from '../data/site';

interface Props {
  counts: Record<string, number>;
}
const { counts } = Astro.props;
---

<section class="section wrap" id="tracks" aria-labelledby="tracks-title">
  <div id="tracks-title"><SectionHeading eyebrow="Families" title="Tracks" lede="Five tracks. Each names one family of weakness. Pick the track that names the flaw you want to study." /></div>
  <div class="tracks" data-reveal>
    {TRACKS.map((t) => (
      <button class="track" type="button" data-track-jump={t.id} aria-label={`Show ${t.label} labs`}>
        <span class="track__name">{t.label}</span>
        <span class="track__focus">{t.focus}</span>
        <span class="track__count">{counts[t.id] ?? 0} {(counts[t.id] ?? 0) === 1 ? 'lab' : 'labs'} →</span>
      </button>
    ))}
  </div>
</section>