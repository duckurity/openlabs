---
import Brand from './Brand.astro';

const year = new Date().getFullYear();
const links = [
  { href: 'https://github.com/Duckurity/openlabs', label: 'Repository' },
  { href: 'https://github.com/Duckurity/openlabs/wiki', label: 'Wiki' },
  { href: 'https://github.com/Duckurity/openlabs/issues', label: 'Report a lab' },
  { href: 'https://github.com/Duckurity/openlabs/blob/main/LICENSE', label: 'License' },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <Brand size={24} mono />
      <span>openlabs · a <a href="https://github.com/Duckurity">duckurity</a> project</span>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul role="list">
        {links.map((l) => (
          <li><a class="site-footer__link" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <p class="site-footer__legal">
      Code Apache-2.0. Written content CC-BY-4.0. © {year}.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-24);
  }
  .site-footer__inner {
    max-width: var(--layout-max);
    margin-inline: auto;
    padding: var(--space-12) var(--layout-gutter) var(--space-10);
    display: grid;
    gap: var(--space-8);
  }
  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  .site-footer__brand a {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    padding-block-end: 1px;
    transition: background-size var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .site-footer__brand a:hover { background-size: 100% 1px; }
  }
  .site-footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    list-style: none;
    padding: 0;
  }
  .site-footer__link {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    padding-block-end: 2px;
    transition: background-size var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .site-footer__link:hover { color: var(--color-text); }
  @media (hover: hover) and (pointer: fine) {
    .site-footer__link:hover { background-size: 100% 1px; }
  }
  .site-footer__legal {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }
</style>