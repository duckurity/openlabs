---
// Light / dark / system theme toggle. The two icons cross-fade and scale on
// switch; the exit/re-enter path mirrors, per the icon-swap pattern. The
// toggle itself is a native button with a real label.
let currentMode = Astro.props.mode as 'light' | 'dark' | 'system' | undefined ?? 'system';
let modeLabel: string;
if (currentMode === 'system') modeLabel = 'System';
else modeLabel = currentMode === 'light' ? 'Light' : 'Dark';
---

<button
  class="theme-toggle"
  data-theme-toggle
  type="button"
  aria-label="Theme: System. Press to change."
>
  <span class="theme-toggle__track" aria-hidden="true">
    <span class="theme-toggle__glider">
      <svg class="tt-sun" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="12" cy="12" r="4" fill="currentColor" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <svg class="tt-moon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" fill="currentColor" />
      </svg>
    </span>
  </span>
  <span class="theme-toggle__label">{modeLabel}</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-1) var(--space-1) var(--space-2);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    transition: transform var(--dur-press) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .theme-toggle:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .theme-toggle:active {
    transform: scale(var(--motion-press-scale));
  }

  .theme-toggle__track {
    position: relative;
    width: 30px;
    height: 18px;
    background: var(--color-border);
    transition: background-color var(--dur-base) var(--ease-out);
  }

  .theme-toggle__glider {
    position: absolute;
    top: 2px;
    left: 2px;
    display: grid;
    place-items: center;
    width: 14px;
    height: 14px;
    background: var(--color-page);
    color: var(--color-text);
    transition: transform var(--dur-base) var(--ease-in-out);
  }

  .theme-toggle[data-mode='dark'] .theme-toggle__glider {
    transform: translateX(12px);
  }

  .tt-sun,
  .tt-moon {
    position: absolute;
    width: 10px;
    height: 10px;
    transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out), filter var(--dur-base) var(--ease-out);
  }
  .tt-sun { opacity: 1; transform: scale(1); filter: blur(0); }
  .tt-moon { opacity: 0; transform: scale(0.25); filter: blur(4px); }
  .theme-toggle[data-mode='dark'] .tt-sun { opacity: 0; transform: scale(0.25); filter: blur(4px); }
  .theme-toggle[data-mode='dark'] .tt-moon { opacity: 1; transform: scale(1); filter: blur(0); }

  .theme-toggle__label {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--text-eyebrow-tracking);
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-toggle__track,
    .tt-sun,
    .tt-moon {
      transition: opacity var(--dur-fast) var(--ease-out);
      transform: none;
      filter: none;
    }
    .theme-toggle__glider {
      transition: none;
    }
  }
</style>