---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base
  title="Page not found — openlabs"
  description="This page does not exist."
  path="/404"
>
  <div class="wrap missing">
    <p class="eyebrow" data-reveal>404</p>
    <pre class="missing__duck" aria-hidden="true" data-reveal style="--reveal-delay: 60ms">{`   __
  <(o )___
   ( ._> /
    \`---'`}</pre>
    <p class="lede" data-reveal style="--reveal-delay: 120ms">This page does not exist.</p>
    <a class="link-sweep missing__home" href={`${base}/`} data-reveal style="--reveal-delay: 180ms">Home</a>
  </div>
</Base>

<style>
  .missing {
    min-height: 50vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    text-align: center;
    padding-block: var(--space-16);
  }
  .missing__duck {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.3;
    color: var(--color-text-secondary);
    user-select: none;
    margin: 0;
  }
  .missing__home {
    font-size: var(--text-sm);
    color: var(--color-accent-text);
  }
  .missing .lede {
    text-align: center;
  }
</style>