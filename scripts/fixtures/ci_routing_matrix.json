{
  "workflow_file": ".github/workflows/labs.yml",
  "required_check": "CI required",
  "full_run_events": ["push", "workflow_dispatch"],
  "full_run_pull_request_actors": ["dependabot[bot]"],
  "examples": [
    {
      "change": "dependabot: package.json only (root site deps)",
      "actor": "dependabot[bot]",
      "run_validate": true,
      "run_security": true,
      "run_content": true,
      "run_pdf": true,
      "run_reference": true
    },
    {
      "change": "scripts/validate_issue_forms.py only",
      "run_validate": true,
      "run_security": false,
      "run_content": false,
      "run_pdf": false,
      "run_reference": false
    },
    {
      "change": "templates/labsheet.cls only",
      "run_validate": false,
      "run_security": false,
      "run_content": false,
      "run_pdf": true,
      "run_reference": false
    },
    {
      "change": "labs/web/duck-cross/README.md",
      "run_validate": true,
      "run_security": true,
      "run_content": true,
      "run_pdf": true,
      "run_reference": true
    },
    {
      "change": "content/guide.mdx only",
      "run_validate": false,
      "run_security": false,
      "run_content": true,
      "run_pdf": false,
      "run_reference": false
    },
    {
      "change": "wiki/Home.md only",
      "run_validate": false,
      "run_security": false,
      "run_content": false,
      "run_pdf": false,
      "run_reference": false,
      "note": "pull_request runs labs workflow; path filter skips expensive jobs"
    }
  ]
}
